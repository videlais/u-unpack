{
  "name": "u-unpack",
  "version": "1.0.1",
  "description": "A command-line tool for unpacking Unity Package (.unitypackage) files",
  "main": "dist/index.js",
  "bin": {
    "u-unpack": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "webpack --mode production",
    "dev:web": "webpack serve --mode development",
    "compile": "bun build --compile ./src/index.ts --outfile dist/u-unpack",
    "compile:linux-x64": "bun build --compile --target=bun-linux-x64 ./src/index.ts --outfile dist/u-unpack-linux-x64",
    "compile:linux-arm64": "bun build --compile --target=bun-linux-arm64 ./src/index.ts --outfile dist/u-unpack-linux-arm64",
    "compile:darwin-x64": "bun build --compile --target=bun-darwin-x64 ./src/index.ts --outfile dist/u-unpack-darwin-x64",
    "compile:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/index.ts --outfile dist/u-unpack-darwin-arm64",
    "compile:windows-x64": "bun build --compile --target=bun-windows-x64 ./src/index.ts --outfile dist/u-unpack-windows-x64.exe",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64 && bun run compile:windows-x64",
    "test": "bun test ./test/*.test.ts",
    "test:coverage": "bun test --coverage ./test/*.test.ts && bun run coverage:check",
    "coverage:check": "bun scripts/check-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run test && bun run test:e2e",
    "lint": "eslint . --fix",
    "clean": "rimraf test/integration-test-* src/integration-test-* guid1 guid2 Assets",
    "all": "bun run lint && bun run build && bun run test && bun run clean"
  },
  "keywords": [
    "unity",
    "unitypackage",
    "unpack",
    "extract",
    "cli"
  ],
  "author": "Dan Cox",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.9.7",
    "@types/pako": "^2.0.4",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.5",
    "html-webpack-plugin": "^5.6.8",
    "path-browserify": "^1.0.1",
    "rimraf": "^6.1.3",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "pako": "^2.2.0",
    "tar": "^7.5.22"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=16.0.0"
  }
}
