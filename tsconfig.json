{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*", "test/index.test.ts", "test/integration.test.ts", "test/unpacker.test.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
